// ==============================================================================
// BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM (SMS)
// UPDATED PRD: Section 7 - Database Design (Highest Priority)
// Primary Database: PostgreSQL 18.x / 17.x (with SQLite compatibility option)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Default for immediate zero-config dev; switch to "postgresql" for local Postgres!
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. IDENTITY & ACCESS (PRD 5.1 & 7.2)
// ------------------------------------------------------------------------------
model User {
  id              String   @id @default(uuid())
  emailNormalized String   @unique // lower(email) trimmed, enforced at DB level
  name            String?
  passwordHash    String   // Argon2id / secure hashed password
  role            String   @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  status          String   @default("ACTIVE")   // ACTIVE, INACTIVE, SUSPENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerAccount CustomerAccount?
  staffInvitesSent StaffInvite[]   @relation("StaffInviter")
  paymentsCreated Payment[]        @relation("PaymentCreator")
  auditLogs       AuditLog[]
  resetTokens     PasswordResetToken[]

  @@index([role, status])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash, expiresAt])
}

model StaffInvite {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("STAFF")
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("StaffInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ------------------------------------------------------------------------------
// 2. CUSTOMER & ORGANIZATIONS (PRD 5.1 & 7.2)
// ------------------------------------------------------------------------------
model CustomerAccount {
  id             String    @id @default(uuid())
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  legalName      String
  billingEmail   String
  taxId          String?   // GST/VAT identifier
  billingAddress String?
  currency       String    @default("USD") // ISO 4217 code
  timezone       String    @default("UTC")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscriptions  Subscription[]
  quotations     Quotation[]
  invoices       Invoice[]

  @@index([billingEmail])
}

// ------------------------------------------------------------------------------
// 3. CATALOGUE: PRODUCTS, VARIANTS, PLANS (PRD 5.2 & 7.2)
// ------------------------------------------------------------------------------
model Product {
  id         String           @id @default(uuid())
  name       String
  type       String           @default("Software") // Software, Add-on, Service
  salesPrice Float            // Base sales price (NUMERIC in PostgreSQL)
  costPrice  Float            // Cost price (Restricted: admin/staff only, never exposed to customers)
  notes      String?
  status     String           @default("ACTIVE")   // ACTIVE, INACTIVE (soft-deactivate)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  variants   ProductVariant[]
  discounts  DiscountEligibility[]

  @@index([status, name])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName  String   // e.g. "Brand", "Edition", "Tier"
  attributeValue String   // e.g. "Odoo", "Enterprise"
  priceDelta     Float    @default(0.0) // Configurable adjustment (e.g. Odoo adds +560.00)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
}

model Plan {
  id              String         @id @default(uuid())
  name            String
  price           Float          // Base plan subscription price
  intervalUnit    String         // DAILY, WEEKLY, MONTHLY, YEARLY
  intervalCount   Int            @default(1)
  minQuantity     Int            @default(1)
  availableFrom   DateTime?
  availableTo     DateTime?
  autoClose       Boolean        @default(false)
  allowEarlyClose Boolean        @default(true)
  allowPause      Boolean        @default(true)
  allowRenew      Boolean        @default(true)
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  templates       QuotationTemplate[]
  subscriptions   Subscription[]
  quotations      Quotation[]

  @@index([status, intervalUnit])
}

// ------------------------------------------------------------------------------
// 4. QUOTATIONS & TEMPLATES (PRD 5.3 & 7.2)
// ------------------------------------------------------------------------------
model QuotationTemplate {
  id           String                  @id @default(uuid())
  name         String
  planId       String?
  plan         Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  validityDays Int                     @default(30)
  status       String                  @default("ACTIVE")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  lines        QuotationTemplateLine[]
  quotations   Quotation[]
}

model QuotationTemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  quantity   Int               @default(1)
  unitPrice  Float
}

model Quotation {
  id            String          @id @default(uuid())
  quoteNumber   String          @unique // e.g. QT-2026-1001
  customerId    String
  customer      CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Restrict)
  templateId    String?
  template      QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  planId        String?
  plan          Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  status        String          @default("DRAFT") // DRAFT, SENT, CONFIRMED, EXPIRED, CANCELLED
  issueDate     DateTime        @default(now())
  expiryDate    DateTime
  subtotal      Float           @default(0.0)
  discountTotal Float           @default(0.0)
  taxTotal      Float           @default(0.0)
  total         Float           @default(0.0)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lines         QuotationLine[]
  subscriptions Subscription[]

  @@index([customerId, status])
}

model QuotationLine {
  id                  String    @id @default(uuid())
  quotationId         String
  quotation           Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId           String
  variantId           String?
  descriptionSnapshot String    // Immutable commercial snapshot
  quantity            Int       @default(1)
  unitPrice           Float
  taxRate             Float     @default(0.0)
  taxAmount           Float     @default(0.0)
  lineTotal           Float
}

// ------------------------------------------------------------------------------
// 5. SUBSCRIPTION CORE & LIFECYCLE (PRD 5.3, 7.2 & 7.4)
// ------------------------------------------------------------------------------
model Subscription {
  id                 String              @id @default(uuid())
  subscriptionNumber String              @unique // e.g. SUB-2026-0001
  customerId         String
  customer           CustomerAccount     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId             String
  plan               Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotationId        String?
  quotation          Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status             String              @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED
  startDate          DateTime
  expiryDate         DateTime
  nextBillingDate    DateTime?           // Indexed for due-billing job scans
  paymentTerms       String              @default("Net 15")
  autoClose          Boolean             @default(false)
  allowPause         Boolean             @default(true)
  allowEarlyClose    Boolean             @default(true)
  allowRenew         Boolean             @default(true)
  renewedFromId      String?             // Linked predecessor term to preserve audit history
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items              SubscriptionItem[]
  events             SubscriptionEvent[]
  invoices           Invoice[]

  @@index([status, nextBillingDate])
  @@index([customerId, status])
}

model SubscriptionItem {
  id                  String       @id @default(uuid())
  subscriptionId      String
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId           String
  variantId           String?
  descriptionSnapshot String
  quantity            Int          @default(1)
  unitPrice           Float
  taxRuleId           String?
  taxRate             Float        @default(0.0)
  amount              Float
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     String
  toStatus       String
  changedBy      String       // Actor email or SYSTEM
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
}

// ------------------------------------------------------------------------------
// 6. TAXES & DISCOUNTS (PRD 5.5 & 7.2)
// ------------------------------------------------------------------------------
model TaxRate {
  id              String    @id @default(uuid())
  name            String    // e.g. "GST 18%", "VAT 20%", "US Sales Tax 8.25%"
  rate            Float     // percentage
  calculationType String    @default("PERCENTAGE")
  jurisdiction    String    @default("GLOBAL")
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, jurisdiction])
}

model DiscountRule {
  id          String                 @id @default(uuid())
  code        String                 @unique // e.g. "WELCOME10", "ENTERPRISE300"
  name        String
  type        String                 @default("PERCENTAGE") // PERCENTAGE, FIXED
  value       Float
  minAmount   Float?
  minQuantity Int?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usageCount  Int                    @default(0) // Concurrency safe atomic counter
  scopeType   String                 @default("ALL") // ALL, PRODUCTS, SUBSCRIPTIONS
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  eligibilities DiscountEligibility[]

  @@index([code, active])
}

model DiscountEligibility {
  id             String       @id @default(uuid())
  discountRuleId String
  discountRule   DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// 7. BILLING RUNS & INVOICING (PRD 5.4, 7.2 & 7.4)
// ------------------------------------------------------------------------------
model BillingRun {
  id                     String    @id @default(uuid())
  runKey                 String    @unique // Durable key for job tracking
  period                 String
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  status                 String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  subscriptionsEvaluated Int       @default(0)
  invoicesGenerated      Int       @default(0)
  skippedCount           Int       @default(0)
  summary                String?

  @@index([status, startedAt])
}

model Invoice {
  id             String              @id @default(uuid())
  invoiceNumber  String              @unique // Sequential human-readable e.g. INV-2026-00101
  customerId     String
  customer       CustomerAccount     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime            @default(now())
  dueAt          DateTime            // Indexed for overdue queries
  status         String              @default("DRAFT") // DRAFT, CONFIRMED, PARTIALLY_PAID, PAID, CANCELLED
  currency       String              @default("USD")
  subtotal       Float               @default(0.0)
  discountTotal  Float               @default(0.0)
  discountRuleId String?
  taxTotal       Float               @default(0.0)
  grandTotal     Float               @default(0.0)
  amountPaid     Float               @default(0.0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines          InvoiceLine[]
  allocations    PaymentAllocation[]

  // CRITICAL IDEMPOTENCY CONSTRAINT (PRD 7.3 & 7.4):
  // Guarantees zero duplicate invoices for the same subscription and billing period!
  @@unique([subscriptionId, periodStart, periodEnd], name: "subscription_period_unique")
  @@index([customerId, status, dueAt])
}

model InvoiceLine {
  id                  String   @id @default(uuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId           String?
  variantId           String?
  descriptionSnapshot String   // Immutable line snapshot
  quantity            Int      @default(1)
  unitPrice           Float
  discountAmount      Float    @default(0.0)
  taxRate             Float    @default(0.0)
  taxAmount           Float    @default(0.0)
  lineTotal           Float

  @@index([invoiceId])
}

// ------------------------------------------------------------------------------
// 8. PAYMENTS & RECONCILIATION (PRD 5.6, 7.2 & 7.4)
// ------------------------------------------------------------------------------
model Payment {
  id            String              @id @default(uuid())
  paymentNumber String              @unique // e.g. PAY-2026-0001
  method        String              @default("CREDIT_CARD") // CREDIT_CARD, BANK_TRANSFER, CASH, UPI, CHECK
  amount        Float               // Positive payment amount
  currency      String              @default("USD")
  paidAt        DateTime            @default(now())
  reference     String?             // Bank transfer ACH / card transaction ID
  note          String?
  createdById   String?
  createdBy     User?               @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  status        String              @default("COMPLETED") // COMPLETED, VOIDED
  voidReason    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  allocations   PaymentAllocation[]

  @@index([paidAt, status])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocatedAmount Float    // Supports partial allocations across invoices
  allocatedAt     DateTime @default(now())

  @@index([invoiceId, allocatedAt])
  @@index([paymentId])
}

// ------------------------------------------------------------------------------
// 9. OPERATIONS, AUDIT & NOTIFICATIONS (PRD 5.7, 7.2 & 11)
// ------------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // INVOICE_CONFIRMED, PAYMENT_RECORDED, SUBSCRIPTION_PAUSED, etc.
  entityType  String   // Invoice, Payment, Subscription, etc.
  entityId    String
  beforeJson  String?  // JSON snapshot before mutation
  afterJson   String?  // JSON snapshot after mutation
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model Notification {
  id            String    @id @default(uuid())
  type          String    // WELCOME, INVOICE_GENERATED, PAYMENT_RECEIPT, OVERDUE_ALERT
  recipient     String
  subject       String
  body          String
  relatedEntity String?
  relatedId     String?
  status        String    @default("SENT") // SENT, PENDING, FAILED
  sentAt        DateTime? @default(now())
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}
